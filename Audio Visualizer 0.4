<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Resonance Spheres | Audio Reactive Visualizer v0.3</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    :root { --bg: #050505; --glass: rgba(20,20,20,0.6); }
    html,body { height:100%; margin:0; font-family: 'Courier New', Courier, monospace; background:var(--bg); overflow:hidden; }
    #canvas-container{ position:absolute; inset:0; z-index:1; }
    #ui-layer{ position:absolute; inset:0; z-index:10; pointer-events:none; display:flex; flex-direction:column; justify-content:space-between; padding:2rem; box-sizing:border-box; }
    .interactive{ pointer-events:auto; }
    .glass-panel{ background:var(--glass); backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.06); box-shadow:0 4px 30px rgba(0,0,0,0.5); }
    .btn-start{ background:linear-gradient(45deg,#ff0055,#ff00aa); border:none; color:#fff; padding:1rem 2.5rem; font-size:1.05rem; letter-spacing:1px; text-transform:uppercase; cursor:pointer; transition:transform .22s, box-shadow .22s; clip-path:polygon(10% 0,100% 0,90% 100%,0% 100%); }
    .btn-start:hover{ transform:scale(1.04); box-shadow:0 0 24px rgba(255,0,85,0.45); }
    .hidden{ opacity:0; pointer-events:none; transition:opacity .45s; }
    .visible{ opacity:1; pointer-events:auto; transition:opacity .45s; }
    .scanlines{ background:linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.15) 50%, rgba(0,0,0,0.15)); background-size:100% 4px; position:absolute; inset:0; pointer-events:none; z-index:5; opacity:0.18; mix-blend-mode:overlay; }
    @media (max-width:640px){ .btn-start{ padding:.8rem 1.6rem; font-size:.95rem; } }
  </style>
</head>
<body>
  <div id="canvas-container"></div>
  <div class="scanlines" aria-hidden="true"></div>

  <div id="ui-layer">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-4xl font-bold text-white tracking-tighter mb-1" style="text-shadow:0 0 10px rgba(255,255,255,0.4);">RESONANCE</h1>
        <p class="text-xs text-gray-400 tracking-widest">AUDIO-VISUAL SYNTHESIS ENGINE // 21 BAND SPHERICAL EQ</p>
      </div>
      <div class="text-right hidden" id="stats-panel">
        <div class="text-xs text-cyan-400 font-mono">FPS: <span id="fps-counter">0</span></div>
        <div class="text-xs text-pink-500 font-mono">VOL: <span id="vol-counter">0.00</span></div>
        <div class="text-xs text-yellow-400 font-mono">COMPLEXITY: <span id="comp-counter">0.00</span></div>
      </div>
    </div>

    <div id="start-screen" class="absolute inset-0 flex items-center justify-center bg-black/80 z-50 interactive backdrop-blur-sm visible transition-opacity duration-700">
      <div class="text-center max-w-md p-8 border border-gray-800 bg-black/90 relative overflow-hidden group">
        <div class="absolute inset-0 bg-gradient-to-r from-pink-500/10 to-cyan-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>
        <h2 class="text-2xl text-white mb-4 font-light">INITIALIZE AUDIO INPUT</h2>
        <p class="text-gray-400 mb-6 text-sm leading-relaxed">This application requires access to your microphone to analyze audio frequencies in real-time.<br><br>21 spheres will react to 21 frequency bands, morphing from smooth to jagged based on volume and texture.</p>
        <button id="start-btn" class="btn-start">Engage System</button>
        <p id="error-msg" class="text-red-500 mt-4 text-xs hidden" role="alert"></p>
      </div>
    </div>

    <div id="controls" class="hidden flex justify-between items-end w-full">
      <div class="glass-panel p-4 rounded-lg text-white text-xs font-mono">
        <div class="mb-2 text-gray-400 uppercase tracking-widest">Parameters</div>
        <div class="flex gap-4">
          <div>
            <label class="block text-gray-500 mb-1">Sensitivity</label>
            <input type="range" id="sensitivity" min="0.5" max="3" step="0.1" value="1.5" class="w-32 accent-pink-500 interactive">
          </div>
          <div>
            <label class="block text-gray-500 mb-1">Smoothing</label>
            <input type="range" id="smoothing" min="0.1" max="0.95" step="0.05" value="0.8" class="w-32 accent-cyan-500 interactive">
          </div>
          <div>
            <label class="block text-gray-500 mb-1">Color Shift</label>
            <input type="range" id="colorShift" min="0" max="1" step="0.01" value="0" class="w-32 accent-yellow-500 interactive">
          </div>
        </div>
      </div>

      <div class="text-right">
        <button id="stop-btn" class="interactive px-4 py-2 border border-red-500/50 text-red-400 hover:bg-red-500/10 text-xs uppercase tracking-widest transition-colors">Terminate Stream</button>
      </div>
    </div>
  </div>

  <script>
    // RESONANCE ENGINE v0.3 - improvements:
    // - Restore a working HTML structure (original was double-encoded)
    // - Reduce geometry detail for performance
    // - Add FPS counter and small optimizations

    const CONFIG = {
      bandCount: 21,
      baseRadius: 1.5,
      spacing: 3.5,
      fftSize: 2048,
      minFreq: 20,
      maxFreq: 15000,
      cameraSpeed: 0.12
    };

    let state = {
      isPlaying: false,
      audioContext: null,
      analyser: null,
      microphone: null,
      dataArray: null,
      sensitivity: 1.2,
      smoothing: 0.8,
      colorOffset: 0,
      time: 0
    };

    let scene, camera, renderer;
    let spheres = [];
    let uniformsGlobal = {
      uTime: { value: 0.0 },
      uColorShift: { value: 0.0 }
    };

    // render-on-demand flag to avoid unnecessary GPU work
    let needsRender = true;
    function markDirty(){ needsRender = true; }

    // camera smoothing helpers to avoid sudden flips when orbiting
    const cameraTarget = new THREE.Vector3(0,0,0);
    const _camDesiredPos = new THREE.Vector3();
    const _camLookMat = new THREE.Matrix4();
    const _camQuat = new THREE.Quaternion();

    // DOM
    const startBtn = document.getElementById('start-btn');
    const stopBtn = document.getElementById('stop-btn');
    const startScreen = document.getElementById('start-screen');
    const controlsDiv = document.getElementById('controls');
    const statsPanel = document.getElementById('stats-panel');
    const errorMsg = document.getElementById('error-msg');

    const sensSlider = document.getElementById('sensitivity');
    const smoothSlider = document.getElementById('smoothing');
    const colorSlider = document.getElementById('colorShift');

    // initialization

    function init(){
      initThree();
      animate();
      startBtn.addEventListener('click', startAudio);
      stopBtn.addEventListener('click', stopAudio);
      sensSlider.addEventListener('input', e => { state.sensitivity = parseFloat(e.target.value); markDirty(); });
      smoothSlider.addEventListener('input', e => {
        state.smoothing = parseFloat(e.target.value);
        if(state.analyser) state.analyser.smoothingTimeConstant = state.smoothing;
        markDirty();
      });
      colorSlider.addEventListener('input', e => {
        state.colorOffset = parseFloat(e.target.value);
        uniformsGlobal.uColorShift.value = state.colorOffset;
        markDirty();
      });
      window.addEventListener('resize', onWindowResize, false);
    }

    function initThree(){
      const container = document.getElementById('canvas-container');
      scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x050505, 0.02);
      camera = new THREE.PerspectiveCamera(60, window.innerWidth/window.innerHeight, 0.1, 1000);
      camera.position.set(0,0,45);
      camera.lookAt(0,0,0);

      renderer = new THREE.WebGLRenderer({ antialias:true, alpha:true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0x222222));
      const pointLight = new THREE.PointLight(0xffffff, 1, 100);
      pointLight.position.set(0,10,10);
      scene.add(pointLight);

      createSpheres();
      createStars();
      markDirty();
    }

    // shaders (kept mostly as original but reused across materials)
    const vertexShader = `
      uniform float uTime;
      uniform float uAudioLevel;
      uniform float uComplexity;
      varying vec3 vNormal;
      varying vec3 vPosition;
      varying float vDisplacement;

      // classic simplex noise (GLSL)
      vec3 mod289(vec3 x){ return x - floor(x * (1.0 / 289.0)) * 289.0; }
      vec4 mod289(vec4 x){ return x - floor(x * (1.0 / 289.0)) * 289.0; }
      vec4 permute(vec4 x){ return mod289(((x*34.0)+1.0)*x); }
      vec4 taylorInvSqrt(vec4 r){ return 1.79284291400159 - 0.85373472095314 * r; }
      float snoise(vec3 v){
        const vec2 C = vec2(1.0/6.0, 1.0/3.0);
        const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
        vec3 i = floor(v + dot(v, C.yyy));
        vec3 x0 = v - i + dot(i, C.xxx);
        vec3 g = step(x0.yzx, x0.xyz);
        vec3 l = 1.0 - g;
        vec3 i1 = min( g.xyz, l.zxy );
        vec3 i2 = max( g.xyz, l.zxy );
        vec3 x1 = x0 - i1 + C.xxx;
        vec3 x2 = x0 - i2 + C.yyy;
        vec3 x3 = x0 - D.yyy;
        i = mod289(i);
        vec4 p = permute( permute( permute(
                  i.z + vec4(0.0, i1.z, i2.z, 1.0 ))
                + i.y + vec4(0.0, i1.y, i2.y, 1.0 ))
                + i.x + vec4(0.0, i1.x, i2.x, 1.0 ));
        float n_ = 0.142857142857;
        vec3 ns = n_ * D.wyz - D.xzx;
        vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
        vec4 x_ = floor(j * ns.z);
        vec4 y_ = floor(j - 7.0 * x_ );
        vec4 x = x_ *ns.x + ns.yyyy;
        vec4 y = y_ *ns.x + ns.yyyy;
        vec4 h = 1.0 - abs(x) - abs(y);
        vec4 b0 = vec4( x.xy, y.xy );
        vec4 b1 = vec4( x.zw, y.zw );
        vec4 s0 = floor(b0)*2.0 + 1.0;
        vec4 s1 = floor(b1)*2.0 + 1.0;
        vec4 sh = -step(h, vec4(0.0));
        vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy ;
        vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww ;
        vec3 p0 = vec3(a0.xy,h.x);
        vec3 p1 = vec3(a0.zw,h.y);
        vec3 p2 = vec3(a1.xy,h.z);
        vec3 p3 = vec3(a1.zw,h.w);
        vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2,p2), dot(p3,p3)));
        p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
        vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
        m = m * m;
        return 42.0 * dot( m*m, vec4( dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3) ) );
      }

      void main(){
        vNormal = normal;
        vec3 pos = position;

        float noiseFreq = 1.0 + (uComplexity * 4.0);
        float noiseAmp = uComplexity * 2.0;
        float noiseVal = snoise(pos * noiseFreq + uTime * 0.5);

        float displacement = noiseVal * noiseAmp;
        displacement += uAudioLevel * 2.0;

        vDisplacement = displacement;
        pos += normal * displacement;
        vPosition = pos;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `;

    const fragmentShader = `
      uniform float uTime;
      uniform float uAudioLevel;
      uniform float uColorShift;
      varying vec3 vNormal;
      varying vec3 vPosition;
      varying float vDisplacement;

      void main(){
        vec3 colorA = vec3(0.1, 0.0, 0.2);
        vec3 colorB = vec3(0.0, 0.8, 1.0);
        vec3 colorC = vec3(1.0, 0.0, 0.5);

        float mixVal = clamp(vDisplacement * 0.5 + uAudioLevel, 0.0, 1.0);
        vec3 finalColor = mix(colorA, colorB, mixVal);
        finalColor = mix(finalColor, colorC, uAudioLevel * abs(sin(uTime + vPosition.x)));

        finalColor = fract(finalColor + uColorShift);

        float fresnel = pow(1.0 - abs(dot(normalize(vNormal), vec3(0.0,0.0,1.0))), 3.0);
        finalColor += vec3(fresnel * 0.5);

        gl_FragColor = vec4(finalColor, 1.0);
      }
    `;

      // call init after shader source strings are initialized
      // (moved to end of script to avoid initialization-order issues)

    function createSpheres(){
      // lower detail to keep multiple spheres performant
      const geometry = new THREE.IcosahedronGeometry(1, 4); // detail 4 -> good balance
      const totalWidth = (CONFIG.bandCount - 1) * CONFIG.spacing;
      const startX = -totalWidth / 2;

      for(let i=0;i<CONFIG.bandCount;i++){
        const material = new THREE.ShaderMaterial({
          uniforms: {
            uTime: uniformsGlobal.uTime,
            uAudioLevel: { value: 0.0 },
            uComplexity: { value: 0.0 },
            uColorShift: uniformsGlobal.uColorShift
          },
          vertexShader,
          fragmentShader,
          transparent: false
        });

        const sphere = new THREE.Mesh(geometry, material);
        sphere.position.x = startX + (i * CONFIG.spacing);
        sphere.position.y = 0;
        sphere.position.z = 0;
        sphere.userData = {
          id: i,
          baseScale: 1.0,
          currentScale: 1.0,
          targetScale: 1.0,
          currentComplexity: 0,
          targetComplexity: 0
        };
        scene.add(sphere);
        spheres.push(sphere);
      }
    }

    function createStars(){
      const geometry = new THREE.BufferGeometry();
      const count = 800; // reduced for performance
      const vertices = new Float32Array(count * 3);
      for(let i=0;i<count;i++){
        vertices[i*3+0] = THREE.MathUtils.randFloatSpread(400);
        vertices[i*3+1] = THREE.MathUtils.randFloatSpread(400);
        vertices[i*3+2] = THREE.MathUtils.randFloatSpread(400);
      }
      geometry.setAttribute('position', new THREE.BufferAttribute(vertices,3));
      const material = new THREE.PointsMaterial({ color: 0x888888, size: 0.7, transparent:true, opacity:0.6 });
      const stars = new THREE.Points(geometry, material);
      scene.add(stars);
    }

    async function startAudio(){
      try{
        state.audioContext = new (window.AudioContext || window.webkitAudioContext)();
        const stream = await navigator.mediaDevices.getUserMedia({ audio:true, video:false });
        state.microphone = state.audioContext.createMediaStreamSource(stream);
        state.analyser = state.audioContext.createAnalyser();
        state.analyser.fftSize = CONFIG.fftSize;
        state.analyser.smoothingTimeConstant = state.smoothing;
        state.microphone.connect(state.analyser);
        const bufferLength = state.analyser.frequencyBinCount;
        state.dataArray = new Uint8Array(bufferLength);

        state.isPlaying = true;
        startScreen.classList.remove('visible'); startScreen.classList.add('hidden');
        controlsDiv.classList.remove('hidden'); controlsDiv.classList.add('visible');
        statsPanel.classList.remove('hidden');
        errorMsg.classList.add('hidden');
        markDirty();
      } catch(err){
        console.error(err);
        errorMsg.textContent = "Error: " + (err.message || err) + ". Please allow microphone access.";
        errorMsg.classList.remove('hidden');
      }
    }

    function stopAudio(){
      if(state.audioContext){
        state.audioContext.close();
        state.audioContext = null;
      }
      state.isPlaying = false;
      startScreen.classList.remove('hidden'); startScreen.classList.add('visible');
      controlsDiv.classList.remove('visible'); controlsDiv.classList.add('hidden');
      statsPanel.classList.add('hidden');

      spheres.forEach(s => { s.userData.targetScale = 1; s.userData.targetComplexity = 0; });
      markDirty();
    }

    function getFrequencyData(){
      if(!state.analyser) return null;
      state.analyser.getByteFrequencyData(state.dataArray);
      return state.dataArray;
    }

    function mapFreqToBand(i){
      if(!state.audioContext || !state.dataArray) return 0;
      const nyquist = state.audioContext.sampleRate / 2;
      const minLog = Math.log2(CONFIG.minFreq);
      const maxLog = Math.log2(CONFIG.maxFreq);
      const logRange = maxLog - minLog;
      const bandLog = minLog + (i / (CONFIG.bandCount - 1)) * logRange;
      const freq = Math.pow(2, bandLog);
      const bin = Math.floor((freq / nyquist) * state.dataArray.length);
      return Math.min(Math.max(bin, 0), state.dataArray.length - 1);
    }

    // simple FPS tracking
    let lastFrame = performance.now();
    // previous timestamp for smooth, delta-based animation
    let prevTime = performance.now();
    let frameCount = 0;
    let fps = 0;
    function updateFPS(now){
      frameCount++;
      const delta = now - lastFrame;
      if(delta >= 1000){
        fps = Math.round((frameCount / delta) * 1000);
        document.getElementById('fps-counter').innerText = fps;
        frameCount = 0;
        lastFrame = now;
      }
    }

    function animate(now){
      requestAnimationFrame(animate);
      if(!now) now = performance.now();
      updateFPS(now);

      // use real delta time for smooth, consistent motion across variable framerates
      const dt = Math.max(0, (now - prevTime) / 1000);
      prevTime = now;
      state.time += dt;
      uniformsGlobal.uTime.value = state.time;

      if(state.isPlaying && state.dataArray){
        const data = getFrequencyData();
        let totalVol = 0;
        let maxVol = 0;

        spheres.forEach((sphere,i) => {
          const binIndex = mapFreqToBand(i);
          let val = 0;
          const range = 2;
          for(let k=-range;k<=range;k++){
            const idx = Math.max(0, Math.min(data.length-1, binIndex + k));
            val += data[idx];
          }
          val = val / (range * 2 + 1);
          const normVal = val / 255;
          totalVol += normVal;
          if(normVal > maxVol) maxVol = normVal;

          const targetScale = CONFIG.baseRadius + (normVal * 4 * state.sensitivity);
          sphere.userData.targetScale = targetScale;
          sphere.userData.targetComplexity = Math.min(1.0, normVal * 1.5);

          sphere.material.uniforms.uAudioLevel.value = normVal;
          sphere.material.uniforms.uComplexity.value = sphere.userData.currentComplexity;

          const s = THREE.MathUtils.lerp(sphere.scale.x, sphere.userData.targetScale, 0.1);
          sphere.scale.setScalar(s);

          sphere.userData.currentComplexity = THREE.MathUtils.lerp(sphere.userData.currentComplexity, sphere.userData.targetComplexity, 0.05);
        });

        const avgVol = totalVol / CONFIG.bandCount;
        document.getElementById('vol-counter').innerText = avgVol.toFixed(2);
        document.getElementById('comp-counter').innerText = maxVol.toFixed(2);
      } else {
        spheres.forEach((sphere,i) => {
          const idleScale = CONFIG.baseRadius + Math.sin(state.time + i) * 0.2;
          sphere.scale.setScalar(THREE.MathUtils.lerp(sphere.scale.x, idleScale, 0.05));
          sphere.material.uniforms.uAudioLevel.value = THREE.MathUtils.lerp(sphere.material.uniforms.uAudioLevel.value, 0, 0.05);
          sphere.material.uniforms.uComplexity.value = THREE.MathUtils.lerp(sphere.material.uniforms.uComplexity.value, 0, 0.05);
        });
      }

      // Camera motion (smoothed figure-8 Lissajous)
      const t = state.time * CONFIG.cameraSpeed;
      const camRadius = 45;
      const camHeight = 35;
      const camWidth = 20;

      // desired position: keep a fixed radial distance while making X a
      // simple left/right (azimuth) oscillation and Y/Z follow a
      // Lissajous-like elevation/depth pattern for depth perception.
      const maxAz = 0.9; // max azimuth radians (~51deg)
      const maxEl = 0.35; // max elevation radians (~20deg)
      const az = Math.sin(t) * maxAz;         // simple left-right control
      const el = Math.sin(t * 2.0) * maxEl;   // Lissajous vertical variation

      // spherical -> Cartesian (radius fixed to camRadius)
      _camDesiredPos.set(
        Math.sin(az) * camRadius * Math.cos(el), // X: left-right
        Math.sin(el) * camRadius,                 // Y: elevation
        Math.cos(az) * camRadius * Math.cos(el)  // Z: depth
      );

      // smooth the camera position to avoid instant jumps
      camera.position.lerp(_camDesiredPos, 0.08);

      // build look matrix and slerp camera orientation for smooth, stable rotations
      _camLookMat.lookAt(camera.position, cameraTarget, camera.up);
      _camQuat.setFromRotationMatrix(_camLookMat);
      camera.quaternion.slerp(_camQuat, 0.12);

      if(state.isPlaying || needsRender){
        renderer.render(scene, camera);
        needsRender = false;
      }
    }

    function onWindowResize(){
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      markDirty();
    }
    // start the app after all functions and shader strings are defined
    init();
  </script>
</body>
</html>
